<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Install on sensor-less devices too; the level shows its quiet empty state. -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:label="Level"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Portrait lock keeps screen axes == device axes, so the tilt math
             needs no display-rotation remapping. -->
        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>